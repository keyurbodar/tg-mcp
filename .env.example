# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Filled in by ./setup.sh login (or: docker compose run --rm tg python -m hub_tg.login)
TELEGRAM_SESSION_STRING=

# Clients send "Authorization: Bearer <token>". setup.sh generates one.
MCP_BEARER_TOKEN=

# Public hostname for the bundled Caddy (only with: docker compose --profile https up -d)
DOMAIN=

# Host port binding. Keep 127.0.0.1 behind Caddy or your own reverse proxy.
MCP_BIND=127.0.0.1
MCP_PORT=8080

# Category for newly seen groups (broadcast channels always start as alpha_ecosystem).
# One of internal_ops, partner_bd, alpha_ecosystem, ignore.
TG_DEFAULT_CATEGORY=internal_ops
# On every start, pull recent history from groups so the backlog is visible.
BACKFILL_HOURS=120
BACKFILL_PER_CHAT_LIMIT=500
