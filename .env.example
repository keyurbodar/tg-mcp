# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Filled in by ./setup.sh login (or: docker compose run --rm tg python -m tg_mcp.login)
TELEGRAM_SESSION_STRING=

# Clients send "Authorization: Bearer <token>". setup.sh generates one.
MCP_BEARER_TOKEN=

# Public hostname for the bundled Caddy (only with: docker compose --profile https up -d)
DOMAIN=
# Public base URL used as the OAuth issuer. Defaults to https://DOMAIN. Set it when you use your own proxy.
PUBLIC_URL=

# OAuth for clients that only speak OAuth (Gemini). setup.sh generates both.
# The login page asks for MCP_BEARER_TOKEN; the plain bearer token keeps working too.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Comma-separated allowlist of redirect URIs. Empty allows any; loopback http URIs are always allowed.
OAUTH_REDIRECT_URIS=
# How the client sends its secret to /token: client_secret_post or client_secret_basic.
OAUTH_TOKEN_AUTH_METHOD=client_secret_post

# Host port binding. Keep 127.0.0.1 behind Caddy or your own reverse proxy.
MCP_BIND=127.0.0.1
MCP_PORT=8080

# On every start, sync dialogs/read-state and backfill recent messages across DMs, groups, and channels.
BACKFILL_HOURS=120
BACKFILL_PER_CHAT_LIMIT=500
